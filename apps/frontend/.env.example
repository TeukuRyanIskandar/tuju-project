# apps/frontend — local env (fake values only; real prod comes from SSM per ADR-0009).
# Only VITE_-prefixed vars are exposed to the client bundle by Vite.

# Configurable API base URL (ADR-0005 migration lever). Leave empty for
# same-origin (behind a proxy); set to the backend origin in split-origin dev.
VITE_API_BASE_URL=http://localhost:3001
