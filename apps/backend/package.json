{
  "name": "@tuju/backend",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 11 backend — identity authority, sole Postgres writer, job producer (scaffold ticket 03; ADR-0001/0003/0004/0005/0006/0010).",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "worker": "nest start --entryFile worker-main",
    "worker:prod": "node dist/worker-main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:int": "jest --config jest.int.config.cjs --runInBand",
    "test:watch": "jest --watch",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@bull-board/api": "^6.7.10",
    "@bull-board/express": "^6.7.10",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@tuju/contracts": "workspace:*",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.3.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "trading-signals": "7.4.3",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.5",
    "yahoo-finance2": "^4.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
