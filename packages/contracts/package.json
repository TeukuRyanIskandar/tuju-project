{
  "name": "@tuju/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared job/result/progress schema — cross-language contract seam (ADR-0002/0007). Zod v4 source of truth generating TS types + Python Pydantic v2 models (ADR-0008).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/*.json": "./fixtures/*.json"
  },
  "files": [
    "dist",
    "src",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
