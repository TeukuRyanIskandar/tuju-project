# tuju-project — example environment (ADR-0009)
#
# FAKE / LOCAL VALUES ONLY. Never put a real secret in this file — it is the only
# env file tracked in git. Copy to `.env` (gitignored) for local dev. In prod these
# values come from AWS SSM Parameter Store via fetch-on-boot (ADR-0009); the app
# only ever reads them from the environment (connection-URL-by-env invariant, ADR-0006).

# --- Postgres (ADR-0004) ---
DATABASE_URL=postgres://tuju:local-dev-password@localhost:5432/tuju

# --- Redis + BullMQ JobBus (ADR-0001) ---
REDIS_URL=redis://localhost:6379

# --- S3 / object storage — LocalStack for dev (ADR-0004/0006) ---
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=tuju-local
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=local-dummy-access-key
AWS_SECRET_ACCESS_KEY=local-dummy-secret-key

# --- Session signing / cookie secret (ADR-0005) ---
SESSION_SECRET=change-me-fake-local-session-secret

# --- CORS (ADR-0005; ticket frontend-foundation/04) ---
# Comma-separated allowlist of browser origins allowed to call the API with the
# session cookie (credentials). Explicit origins only: "*" and empty entries are
# rejected at startup. Defaults to http://localhost:5173 (Vite dev) when unset.
# Production SPA origin: TBD (ADR-0005 open question).
CORS_ORIGINS=http://localhost:5173

# --- Production placeholders (ADR-0005 open question; DO NOT uncomment locally) ---
# Real values are decided with the production domain layout and come from SSM
# (ADR-0009). The <...> tokens are placeholders, not real domains.
# COOKIE_DOMAIN unset = host-only cookie on the API host; COOKIE_SECURE already
# defaults to true when NODE_ENV=production; SameSite=lax suffices while the SPA
# and API share a site.
# CORS_ORIGINS=https://<production-spa-origin>
# COOKIE_DOMAIN=<.shared-parent-domain>
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# --- Vendor market-data API keys (ticket 10; fake locally, real in SSM) ---
EODHD_API_KEY=fake-eodhd-key

# --- PoC Phase A market/fundamentals source (`synthetic` | `yfinance`) ---
# Default synthetic keeps free-tier local demo offline. Set yfinance for the
# KLCI-30 PoC path (yahoo-finance2 behind MARKET_DATA / FUNDAMENTALS adapters).
DATA_SOURCE=synthetic

# --- AI worker (services/ai) ---
# S3 prefix the Python worker writes analysis artifacts under (ADR-0004 claim-check).
S3_ARTIFACTS_PREFIX=analysis
# Base URL of the NestJS API's anonymous read surface — the market-brief/
# announcement-summary jobs fetch via NestJS rather than touching Postgres
# directly (ADR-0004).
BACKEND_API_URL=http://localhost:3000
# LLM provider: OpenRouter (OpenAI-compatible). Used by the analyze-prospectus job.
# Leave the key EMPTY locally: the job then fails cleanly (terminal, no retry)
# instead of calling out. Put a real key in your gitignored `.env` only; in prod
# it comes from SSM (ADR-0009). NEVER commit a real key here.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
# Optional overrides (defaults shown):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_PROMPT_CACHE=false          # opt-in OpenRouter cache_control breakpoints
# LLM_COST_CEILING_USD=2.0        # per-document spend ceiling (job aborts above it)
# LLM_PRICE_TABLE_JSON={"vendor/model":{"input":0.3,"output":2.5,"cachedInput":0.075}}
# WORKER_LOCK_DURATION_MS=300000  # BullMQ lock; first prospectus parse is 4-11 min CPU
# PROSPECTUS_S3_PREFIX=prospectus # read-only corpus prefix for seeded PDFs
